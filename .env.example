# logistics-voice-agent environment template
# Copy this file to .env, then add local credentials. Never commit .env.

# LiveKit Cloud worker modes (dev/start). Not required for console mode.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram STT. DEEPGRAM_API_KEY is canonical; DEEPGRAM_KEY is accepted as a legacy alias.
DEEPGRAM_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=
# Optional; blank uses the low-latency default in the application.
CLAUDE_MODEL=

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# Reserved for a future pgvector extension; not used by the current MVP.
SUPABASE_URL=
SUPABASE_KEY=
