# =============================================================================
# livekit-ops-agent — plantilla de variables de entorno
# Copia este fichero a `.env` y rellena los valores. El `.env` real NO se commitea.
# Los nombres son los CANÓNICOS que lee el código (BaseSettings). No los renombres.
# =============================================================================

# --- LiveKit Cloud (fase 2: modos dev / start) -------------------------------
# Ausentes => el agente degrada a `console` sin fallar.
# LIVEKIT_URL         -> LiveKit Cloud > PROJECT > General (empieza por wss://)
# LIVEKIT_API_KEY     -> LiveKit Cloud > API keys > Create key
# LIVEKIT_API_SECRET  -> mismo modal de Create key (solo se muestra esa vez)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT: Deepgram -----------------------------------------------------------
# OJO: en Karumi la variable se llama DEEPGRAM_KEY; aquí el nombre canónico es
# DEEPGRAM_API_KEY (el valor es el mismo). El código acepta DEEPGRAM_KEY como
# fallback defensivo.
DEEPGRAM_API_KEY=

# --- LLM: Anthropic ----------------------------------------------------------
ANTHROPIC_API_KEY=
# Modelo Claude: priorizar LATENCIA. Vacío => default de baja latencia del código.
CLAUDE_MODEL=

# --- TTS: ElevenLabs ---------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# --- RAG: Supabase (opcional — reservado, no usado por el MVP) ----------------
SUPABASE_URL=
SUPABASE_KEY=
